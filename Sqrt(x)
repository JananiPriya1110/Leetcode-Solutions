class Solution {
    public int mySqrt(int x) {
        int start = 0;
        int end = x;
        int ans = 0;
        if (x == 0) {
             return 0;
        }
        while(start<= end){
            int mid = start+(end-start)/2;
            /*
            if(mid*mid <== x){
                return mid;
            }
            if(mid*mid < x){
                start = mid+1;
            }
            else{
                end = mid-1;
            }
        }
        */
        if(mid == 0 ){
            start = mid+1;
        }
        else{
           if(mid> 0 && mid == x/mid && x % mid == 0){
            return mid;
        }
        if(mid > 0 && mid <= x/mid){
               ans = mid;
               start = mid+1;
            }
            /*
        if(mid > 0 && mid < x/mid){
                start = mid+1;
            }*/
            else {
                end = mid-1;
            }

        }
      
    }
    return ans;
}}
