class Solution {
    public int lengthOfLongestSubstring(String s) {
        int left = 0;
        int maxLen = 0;
        int[] map = new int[256];
        for (int i = 0; i < 256; i++) map[i] = -1;
        for (int right = 0; right < s.length(); right++) {
            char ch = s.charAt(right);

            if (map[ch] != -1) {
                left = Math.max(left, map[ch] + 1);
            }
            map[ch] = right;

            maxLen = Math.max(maxLen, right - left + 1);
        }

        return maxLen;
    }
}
